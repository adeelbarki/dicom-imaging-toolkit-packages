{
  "name": "dicom-imaging-toolkit-packages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the DICOM imaging toolkit: a shared geometry core and the RT/SEG domain packages built on it.",
  "license": "MIT",
  "author": "Adeel Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeelbarki/dicom-imaging-toolkit-packages.git"
  },
  "homepage": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages#readme",
  "bugs": {
    "url": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:deps": "node scripts/check-dependency-rule.mjs",
    "test": "npm run check:deps && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}

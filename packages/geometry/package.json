{
  "name": "rt-geometry-js",
  "version": "1.1.0",
  "type": "module",
  "description": "Shared geometry core for DICOM imaging toolkits: GridGeometry, Mask3D, ScalarField3D, resampling-ready histograms, analytic phantoms, and comparison metrics. No DICOM, network, or filesystem dependency.",
  "keywords": [
    "dicom",
    "medical-imaging",
    "geometry",
    "voxel",
    "mask",
    "grid",
    "radiotherapy",
    "histogram"
  ],
  "license": "MIT",
  "author": "Adeel Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeelbarki/dicom-imaging-toolkit-packages.git",
    "directory": "packages/geometry"
  },
  "homepage": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/tree/main/packages/geometry#readme",
  "bugs": {
    "url": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "CONTRACT.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "node ../../scripts/check-dependency-rule.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/browser": "^3.2.7",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}

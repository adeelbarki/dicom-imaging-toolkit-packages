{
  "name": "rtstruct-js",
  "version": "0.3.2",
  "type": "module",
  "description": "DICOM RT Structure Set reading and writing, validated against analytic phantoms.",
  "keywords": [
    "dicom",
    "rtstruct",
    "rt-struct",
    "radiotherapy",
    "medical-imaging",
    "contour",
    "segmentation",
    "dcmjs"
  ],
  "license": "MIT",
  "author": "Adeel Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeelbarki/dicom-imaging-toolkit-packages.git",
    "directory": "packages/rtstruct"
  },
  "homepage": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/tree/main/packages/rtstruct#readme",
  "bugs": {
    "url": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "npm run check:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:deps": "node ../../scripts/check-dependency-rule.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "npm run build --workspace rt-geometry-js",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "rt-geometry-js": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rt-geometry-js": "^1.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dcmjs": "^0.52.0"
  }
}

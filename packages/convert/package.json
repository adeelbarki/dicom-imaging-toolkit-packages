{
  "name": "rt-convert-js",
  "version": "0.1.0",
  "type": "module",
  "description": "Convert between DICOM RT Structure Sets and DICOM Segmentation, with every lossy step recorded in provenance. Built on rt-geometry-js, rtstruct-js, and dicom-seg-js.",
  "keywords": [
    "dicom",
    "rtstruct",
    "dicom-seg",
    "segmentation",
    "conversion",
    "radiotherapy",
    "medical-imaging",
    "dcmjs"
  ],
  "license": "MIT",
  "author": "Adeel Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeelbarki/dicom-imaging-toolkit-packages.git",
    "directory": "packages/convert"
  },
  "homepage": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/tree/main/packages/convert#readme",
  "bugs": {
    "url": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs/CONVERSION.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "npm run check:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:deps": "node ../../scripts/check-dependency-rule.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "npm run build --workspace rt-geometry-js --workspace rtstruct-js --workspace dicom-seg-js",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "dicom-seg-js": "^0.1.1",
    "rt-geometry-js": "^1.0.0",
    "rtstruct-js": "^0.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dicom-seg-js": "^0.1.1",
    "rt-geometry-js": "^1.0.0",
    "rtstruct-js": "^0.3.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}

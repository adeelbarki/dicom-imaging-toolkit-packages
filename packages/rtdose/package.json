{
  "name": "rtdose-js",
  "version": "0.1.1",
  "type": "module",
  "description": "DICOM RTDOSE reading and dose-volume histograms (D95/V20/mean), built on rt-geometry-js. Research/QA tooling — not a treatment planning system.",
  "keywords": [
    "dicom",
    "rtdose",
    "rt-dose",
    "dvh",
    "dose-volume-histogram",
    "radiotherapy",
    "medical-imaging",
    "dcmjs"
  ],
  "license": "MIT",
  "author": "Adeel Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeelbarki/dicom-imaging-toolkit-packages.git",
    "directory": "packages/rtdose"
  },
  "homepage": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/tree/main/packages/rtdose#readme",
  "bugs": {
    "url": "https://github.com/adeelbarki/dicom-imaging-toolkit-packages/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs/DVH-METHOD.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "npm run check:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:deps": "node ../../scripts/check-dependency-rule.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "npm run build --workspace rt-geometry-js",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "rt-geometry-js": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rt-geometry-js": "^1.0.0",
    "rtstruct-js": "*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "dcmjs": "^0.52.0"
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // `paths` in the base config maps rt-geometry-js to its source for typecheck/tests.
    // The published build must resolve it as a real dependency (its built dist/) and keep
    // the bare specifier in the emitted JS — so clear the mapping here.
    "paths": {}
  },
  "include": ["src"]
}
